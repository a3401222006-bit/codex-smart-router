#!/bin/sh
# Resolve symlinks through Node so installation links retain the correct root.
exec node --input-type=module -e '
import { realpathSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { pathToFileURL } from "node:url";
const root = resolve(dirname(realpathSync(process.argv[1])), "..");
const { main } = await import(pathToFileURL(resolve(root, "skills/codex-smart-router/scripts/router.mjs")));
process.exitCode = main(process.argv.slice(2));
' "$0" "$@"
