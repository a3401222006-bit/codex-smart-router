#!/usr/bin/env zsh
# Route a Codex CLI task to a model and reasoning effort before starting it.
#
# Usage:
#   codex-smart "your task"
#   codex-smart --route "your task"  # show the decision only

set -euo pipefail

ROUTE_ONLY=false

if [[ "${1:-}" == "--route" ]]; then
  ROUTE_ONLY=true
  shift
fi

if (( $# == 0 )); then
  print -u2 "Usage: codex-smart [--route] <task description>"
  exit 64
fi

if [[ -n "${CODEX_BIN:-}" ]]; then
  : # Respect an explicit path, useful for desktop-app bundled CLIs.
elif (( $+commands[codex] )); then
  CODEX_BIN="${commands[codex]}"
elif [[ -x "/Applications/ChatGPT.app/Contents/Resources/codex" ]]; then
  CODEX_BIN="/Applications/ChatGPT.app/Contents/Resources/codex"
else
  print -u2 "Codex CLI was not found. Install it, add it to PATH, or set CODEX_BIN."
  exit 69
fi

if [[ ! -x "$CODEX_BIN" ]]; then
  print -u2 "Codex CLI is not executable: $CODEX_BIN"
  exit 69
fi

TASK="$*"
ROUTE_FILE="$(mktemp "${TMPDIR:-/tmp}/codex-smart-route.XXXXXX")"
trap 'rm -f "$ROUTE_FILE"' EXIT

ROUTER_PROMPT="You are a strict Codex task router. Do not use tools, inspect files, or explain your answer. Based only on the task below, output exactly one line in this format:
MODEL|EFFORT

Allowed MODEL values: gpt-5.6-luna, gpt-5.6-terra, gpt-5.6-sol.
Allowed EFFORT values: minimal, low, medium, high, xhigh.

Choose gpt-5.6-luna with minimal or low for explicit, low-risk, repetitive tasks: extraction, formatting, renaming, small mechanical edits, summaries, and straightforward questions.
Choose gpt-5.6-terra with medium for ordinary coding, tests, code reading, and routine debugging. Use terra|high for a multi-file change, an unclear bug, or validation across components.
Choose gpt-5.6-sol with high for architecture, cross-module refactors, difficult diagnosis, or ambiguous high-value work. Use sol|xhigh only for security-sensitive, production-critical, irreversible, or exceptionally difficult work.
Prefer the lowest-cost option that is likely to finish correctly. Never select xhigh merely because a task is long.

Task:
$TASK"

"$CODEX_BIN" exec --ephemeral --skip-git-repo-check --ignore-rules \
  -s read-only -m gpt-5.6-luna \
  -c 'model_reasoning_effort="low"' \
  -o "$ROUTE_FILE" "$ROUTER_PROMPT" >/dev/null

ROUTE="$(tr -d '[:space:]' < "$ROUTE_FILE" | tail -n 1)"
MODEL="${ROUTE%%|*}"
EFFORT="${ROUTE#*|}"

case "$MODEL|$EFFORT" in
  gpt-5.6-luna\|minimal|gpt-5.6-luna\|low|gpt-5.6-luna\|medium|gpt-5.6-terra\|low|gpt-5.6-terra\|medium|gpt-5.6-terra\|high|gpt-5.6-sol\|medium|gpt-5.6-sol\|high|gpt-5.6-sol\|xhigh)
    ;;
  *)
    print -u2 "Router returned an invalid decision: ${ROUTE:-<empty>}; falling back to Terra|medium."
    MODEL="gpt-5.6-terra"
    EFFORT="medium"
    ;;
esac

print "codex-smart -> $MODEL | $EFFORT"

if [[ "$ROUTE_ONLY" == true ]]; then
  exit 0
fi

exec "$CODEX_BIN" -m "$MODEL" -c "model_reasoning_effort=\"$EFFORT\"" "$TASK"
